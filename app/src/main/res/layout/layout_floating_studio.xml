<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_glass_modal"
    android:elevation="12dp"
    android:orientation="vertical"
    android:padding="18dp">

    <!-- شريط الأيقونات الزجاجية العلوي -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentLeft="true"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/btn_close"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="@drawable/bg_glass_card"
                android:padding="6dp"
                android:src="@android:drawable/ic_menu_close_clear_cancel" />

            <ImageView
                android:id="@+id/btn_settings"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_glass_card"
                android:padding="6dp"
                android:src="@android:drawable/ic_menu_preferences" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentRight="true"
            android:text="⚡ APEX ROYAL STUDIO"
            android:textColor="@color/neon_gold"
            android:textSize="15sp"
            android:textStyle="bold" />
    </RelativeLayout>

    <!-- الأزرار المتقاسمة (المعرض والمستودع) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginBottom="14dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btn_gallery"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:background="@drawable/bg_glass_card"
            android:stateListAnimator="@null"
            android:text="🖼 من المعرض"
            android:textColor="@color/text_primary" />

        <Button
            android:id="@+id/btn_repository"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:background="@drawable/bg_btn_gold_glass"
            android:stateListAnimator="@null"
            android:text="📂 من المستودع"
            android:textColor="#0B0F19"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- زر التشغيل المضيء -->
    <Button
        android:id="@+id/btn_run_job"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:background="@drawable/bg_btn_emerald_glass"
        android:stateListAnimator="@null"
        android:text="▶ Run Job"
        android:textColor="@color/neon_emerald"
        android:textSize="16sp"
        android:textStyle="bold" />
</LinearLayout>
