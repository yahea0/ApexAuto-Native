<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0B0C10"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="APEX AUTO PRO"
            android:textColor="#FFD700"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="AI Multi-Angle Autonomous Studio"
            android:textColor="#94A3B8"
            android:textSize="13sp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginVertical="20dp"
            android:background="#1E293B" />

        <!-- 1. محرك النقر المباشر -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#12141D"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="1. محرك النقر المباشر (Core Touch)"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btn_enable_accessibility"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="12dp"
                android:backgroundTint="#FFD700"
                android:text="⚡ تفعيل خدمة النقر (ACCESSIBILITY)"
                android:textColor="#0B0C10"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- 2. استوديو الأتمتة العائم -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="#12141D"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="2. استوديو الأتمتة العائم (Floating Studio)"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btn_start_overlay"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="12dp"
                android:backgroundTint="#10B981"
                android:text="🔘 تشغيل الاستوديو العائم للأتمتة"
                android:textColor="#FFFFFF"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- 3. قسم مكتبة ومستودع الصور وتدريب الذكاء الاصطناعي (NEW) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="#12141D"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="3. مستودع الصور وإدارة الأهداف (Targets Library)"
                android:textColor="#FFD700"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="استعراض الأهداف المحفوظة، إعادة تسميتها، وحذفها أو إضافة صور جديدة"
                android:textColor="#64748B"
                android:textSize="11sp" />

            <Button
                android:id="@+id/btn_open_library"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="12dp"
                android:backgroundTint="#1F222E"
                android:text="📁 إدارة مستودع الصور والأهداف"
                android:textColor="#FFD700"
                android:textStyle="bold" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
