<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0F172A"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ApexAuto Native"
            android:textColor="#38BDF8"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="YOLOv12-N Native Autonomous Engine"
            android:textColor="#94A3B8"
            android:textSize="14sp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginVertical="24dp"
            android:background="#334155" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="خطوة 1: أدخل رمز الاقتران اللاسلكي (Pairing Code)"
            android:textColor="#F8FAFC"
            android:textSize="13sp" />

        <EditText
            android:id="@+id/edit_pair_code"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="8dp"
            android:background="#1E293B"
            android:hint="أدخل الرمز المكون من 6 أرقام"
            android:inputType="number"
            android:paddingHorizontal="16dp"
            android:textColor="#FFFFFF"
            android:textColorHint="#64748B" />

        <Button
            android:id="@+id/btn_pair"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="12dp"
            android:backgroundTint="#0284C7"
            android:text="اقتران وتشغيل المحرك الأصلي (Deploy C++)"
            android:textColor="#FFFFFF"
            android:textStyle="bold" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginVertical="24dp"
            android:background="#334155" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="خطوة 2: تشغيل الواجهة العائمة للأتمتة"
            android:textColor="#F8FAFC"
            android:textSize="13sp" />

        <Button
            android:id="@+id/btn_start_overlay"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="8dp"
            android:backgroundTint="#10B981"
            android:text="تشغيل زر التحكم العائم (Overlay)"
            android:textColor="#FFFFFF"
            android:textStyle="bold" />

    </LinearLayout>
</ScrollView>
